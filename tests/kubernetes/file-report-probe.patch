diff --git a/tests/kubernetes/contract.py b/tests/kubernetes/contract.py
index 61662d2..1bf0f25 100644
--- a/tests/kubernetes/contract.py
+++ b/tests/kubernetes/contract.py
@@ -67,0 +68 @@ def main(opts, temp):
+    print("FILE_REPORT_STAGE namespace_created", flush=True)
@@ -91,0 +93 @@ def main(opts, temp):
+        print("FILE_REPORT_STAGE deployments_ready", flush=True)
@@ -95,0 +98 @@ def main(opts, temp):
+            print("FILE_REPORT_STAGE worker_job_created", flush=True)
@@ -181,0 +185 @@ def run_file_report(client, kube, temp, cert):
+    print("FILE_REPORT_STAGE task_submitted", flush=True)
@@ -213,4 +217,59 @@ def run_file_report(client, kube, temp, cert):
-        print(kube("logs", "deployment/model")[-1500:], file=sys.stderr)
-        for pod in json.loads(kube("get", "pods", "-o", "json"))["items"]:
-            if "job-name" in pod["metadata"].get("labels", {}):
-                print(kube("logs", "pod/" + pod["metadata"]["name"])[-1500:], file=sys.stderr)
+        # Query the terminal API record independently; the Worker reports its
+        # own finish acknowledgement. Never copy raw native or model logs.
+        try:
+            record = json.loads(client.request("GET", client.route))
+        except (OSError, ValueError):
+            record = {}
+        deadline = time.monotonic() + 20
+        pod = terminal = None
+        while True:
+            pods = json.loads(kube("get", "pods", "-l", "job-name=produce", "-o", "json"))["items"]
+            if len(pods) == 1:
+                pod = pods[0]
+                terminal = next((c["state"].get("terminated") for c in pod["status"].get("containerStatuses", [])
+                                 if c["name"] == "worker"), None)
+            if terminal or time.monotonic() >= deadline:
+                break
+            time.sleep(.2)
+        try:
+            logs = kube("logs", "pod/" + pod["metadata"]["name"]) if pod else ""
+        except subprocess.SubprocessError:
+            logs = ""
+        lines = [line.removeprefix("FILE_PROBE ") for line in logs.splitlines()
+                 if line.startswith("FILE_PROBE ")]
+        sessions = [str(uuid.UUID(line.split()[1])) for line in lines if line.startswith("session ")]
+        expected = [
+            "version codex-cli 0.171.0-alpha.13",
+            "native item.started in_progress none true",
+            "native item.completed failed approval_required_policy_never true",
+            "turn failed",
+            "rpc initialize observed=true absent=false",
+            "rpc tools_list observed=true absent=false",
+            "rpc render_call observed=false absent=true",
+            "files stage_absent=true report_absent=true",
+            "finish acknowledged=true failed=true assets=0",
+        ]
+        matched = [line for line in lines if line in expected]
+        assets = len(record.get("assets", [])) if record else None
+        turns = len(json.loads(kube("get", "jobs", "-l", "agentmoor.io/turn", "-o", "json"))["items"])
+        confirmed = (all(matched.count(line) == 1 for line in expected)
+                     and matched.index(expected[1]) < matched.index(expected[2])
+                     and len(sessions) == 1 and "publication entered" not in lines
+                     and record.get("state") == "failed" and assets == 0 and turns == 0
+                     and terminal is not None and terminal["exitCode"] != 0)
+        # Preserve known observations even if they differ from the expected failure.
+        # Unknown and incomplete observations carry no tool/publishing verdict.
+        safe = re.compile(r"(?:native item\.(?:started|completed) (?:in_progress|completed|failed|unknown) "
+                          r"(?:none|other_error|approval_required_policy_never) (?:true|false)"
+                          r"|rpc (?:initialize|tools_list|render_call) observed=(?:true|false) absent=(?:true|false)"
+                          r"|files stage_absent=(?:true|false) report_absent=(?:true|false)"
+                          r"|finish acknowledged=(?:true|false) failed=(?:true|false) assets=\d+"
+                          r"|version codex-cli 0\.171\.0-alpha\.13|turn failed|publication entered)")
+        selected = [line for line in lines if safe.fullmatch(line)]
+        print("FILE_REPORT_DIAG " + json.dumps({
+            "confirmed": confirmed and sorted(selected) == sorted(expected),
+            "pod_uid": str(uuid.UUID(pod["metadata"]["uid"])) if pod else None,
+            "native_sessions": sessions, "observed": selected,
+            "api_failed": record.get("state") == "failed" if record else None, "api_assets": assets, "turn_jobs": turns,
+            "worker_exit": terminal["exitCode"] if terminal else None,
+        }, sort_keys=True), flush=True)
diff --git a/tests/kubernetes/report_tool.py b/tests/kubernetes/report_tool.py
index 1bc989d..09e34cb 100755
--- a/tests/kubernetes/report_tool.py
+++ b/tests/kubernetes/report_tool.py
@@ -12,0 +13,7 @@ def handle(method, params):
+    # Observe discovery and delivery separately. Stop at the RPC boundary if
+    # client behavior changes; this diagnostic never performs a render.
+    if method in ("initialize", "tools/list"):
+        Path(".probe_" + method.replace("/", "_")).touch()
+    if method == "tools/call" and params.get("name") == "render":
+        Path(".probe_render_call").touch()
+        raise ValueError("observer stopped before render")
