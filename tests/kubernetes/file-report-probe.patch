@@ -71 +71,5 @@ func runTurn(ctx context.Context, env task.Environment, prompt []byte, id string
-	if err := adapter.RunCLIInput(ctx, env.Executable, env.Workspace, vars, bytes.NewReader(prompt), &out, 2<<20, append(args, "-")...); err != nil {
+	err := adapter.RunCLIInput(ctx, env.Executable, env.Workspace, vars, bytes.NewReader(prompt), &out, 2<<20, append(args, "-")...)
+	if fileSettings != nil {
+		probeNative(out.Bytes())
+	}
+	if err != nil {
@@ -78,0 +83,44 @@ func runTurn(ctx context.Context, env task.Environment, prompt []byte, id string
+// Keep only known event labels and the native identity from this synthetic run.
+// In particular, do not log prompts, tool arguments, arbitrary errors or stdout.
+func probeNative(data []byte) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	for {
+		var e struct {
+			Type   string
+			Thread string `json:"thread_id"`
+			Item   struct {
+				Type, Server, Tool, Status string
+				Error                      *struct{ Message string }
+				Result                     json.RawMessage
+			}
+		}
+		if err := dec.Decode(&e); err != nil {
+			return
+		}
+		switch e.Type {
+		case "thread.started":
+			if sessionfile.UUID(e.Thread) {
+				fmt.Fprintln(os.Stderr, "FILE_PROBE session", e.Thread)
+			}
+		case "item.started", "item.completed":
+			if e.Item.Type != "mcp_tool_call" || e.Item.Server != "report" || e.Item.Tool != "render" {
+				continue
+			}
+			status := e.Item.Status
+			if status != "in_progress" && status != "completed" && status != "failed" {
+				status = "unknown"
+			}
+			reason := "none"
+			if e.Item.Error != nil {
+				reason = "other_error"
+				if e.Item.Error.Message == "MCP tool call requires approval, but approval policy is never" {
+					reason = "approval_required_policy_never"
+				}
+			}
+			fmt.Fprintf(os.Stderr, "FILE_PROBE native %s %s %s %t\n", e.Type, status, reason, string(e.Item.Result) == "null")
+		case "turn.failed":
+			fmt.Fprintln(os.Stderr, "FILE_PROBE turn failed")
+		}
+	}
+}
+
